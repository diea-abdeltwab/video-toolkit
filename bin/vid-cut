#!/usr/bin/env bash
# =============================================================================
# vid-cut — video clip cutter by time range, or chapter splitter
#
# Usage:
#   vid-cut <video> -s 0:30 -e 1:45              cut from 00:30 → 01:45
#   vid-cut <video> -s 1:20:00 -e 1:25:30        HH:MM:SS format
#   vid-cut <video> -s 90 -e 150                 raw seconds
#   vid-cut <video> -s 0:30 -e 1:45 -o clip.mp4  custom output file
#   vid-cut <video> -s 0:30 -e 1:45 --fast       fast cut (stream copy)
#   vid-cut <video> -s 0:30 -e 1:45 -y           overwrite output if exists
#   vid-cut --info <video>                        show video info and exit
#   vid-cut <video> --chapters                    split all chapters to numbered files
#   vid-cut <video> --chapters --fast -o ./out/   chapters with stream copy to folder
# =============================================================================

set -uo pipefail

VERSION="1.2.0"

# ── Colors ────────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
    GRN=$'\033[0;32m'; YLW=$'\033[0;33m'; RED=$'\033[0;31m'
    BLU=$'\033[0;34m'; CYN=$'\033[0;36m'; BLD=$'\033[1m'; RST=$'\033[0m'
else
    GRN=""; YLW=""; RED=""; BLU=""; CYN=""; BLD=""; RST=""
fi

log_info() { echo -e "${BLU}[*]${RST} $*"; }
log_ok()   { echo -e "${GRN}[+]${RST} $*"; }
log_warn() { echo -e "${YLW}[!]${RST} $*"; }
log_err()  { echo -e "${RED}[!]${RST} $*" >&2; }

# ── Check dependencies ────────────────────────────────────────────────────────
_missing=()
command -v ffmpeg  &>/dev/null || _missing+=("ffmpeg")
command -v ffprobe &>/dev/null || _missing+=("ffprobe")
if [[ ${#_missing[@]} -gt 0 ]]; then
    log_err "Missing required tool(s): ${_missing[*]}"
    echo    "  Ubuntu/Debian : sudo apt install ffmpeg"
    echo    "  macOS         : brew install ffmpeg"
    exit 1
fi

# ── Help ──────────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
${BLD}vid-cut${RST} v${VERSION} — cut a video clip by time range, or split by chapters

${BLD}USAGE${RST}
  vid-cut <video> -s <start> -e <end> [options]   # cut a single clip
  vid-cut <video> --chapters [options]             # split all chapters

${BLD}TIME FORMATS${RST}
  HH:MM:SS    e.g.  1:20:05
  MM:SS       e.g.  3:45
  seconds     e.g.  225

${BLD}OPTIONS${RST}
  -s, --start   TIME   Start time  (required for clip mode)
  -e, --end     TIME   End time    (required for clip mode)
  -o, --output  PATH   Output file (clip mode) or output directory (chapters mode)
  --chapters           Split the video into one file per chapter (numbered)
  --fast               Stream copy — faster, no re-encode, less precise cuts
  -y, --overwrite      Overwrite output file(s) if they already exist
  --info <video>       Show video info (including chapters) and exit
  -v, --version        Show version and exit
  -h, --help           Show this help

${BLD}EXAMPLES${RST}
  vid-cut video.mp4 -s 0:30 -e 1:45
  vid-cut video.mp4 -s 1:20:00 -e 1:25:30 -o highlight.mp4
  vid-cut video.mp4 -s 90 -e 150 --fast
  vid-cut video.mp4 --chapters
  vid-cut video.mp4 --chapters --fast -o ./parts/
  vid-cut video.mp4 --chapters -y
  vid-cut --info video.mp4

${BLD}MODES${RST}
  Default     Frame-accurate cut via re-encode (libx264 crf 18). Slightly slower.
  --fast      Stream copy — instant, no quality loss, but cut snaps to keyframes.
  --chapters  Reads embedded chapter metadata and exports each chapter as a
              numbered file: 01_<title>.mp4, 02_<title>.mp4, ...
EOF
}

# ── Parse time → validate format, return as-is for ffmpeg ────────────────────
parse_time() {
    local t="$1"
    # Accept H:M:S or M:S (any number of digits in each field) or raw seconds
    if [[ "$t" =~ ^[0-9]+(:[0-9]+){1,2}(\.[0-9]+)?$ ]]; then
        echo "$t"; return
    fi
    if [[ "$t" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        echo "$t"; return
    fi
    log_err "Bad time format: '${t}'  (accepted: HH:MM:SS, MM:SS, or raw seconds)"
    exit 1
}

# ── Convert time string → integer seconds ─────────────────────────────────────
to_seconds() {
    local t="$1" h m s
    if [[ "$t" =~ ^([0-9]+):([0-9]+):([0-9]+)(\.[0-9]+)?$ ]]; then
        h=${BASH_REMATCH[1]}; m=${BASH_REMATCH[2]}; s=${BASH_REMATCH[3]}
        echo $(( h*3600 + m*60 + s ))
    elif [[ "$t" =~ ^([0-9]+):([0-9]+)(\.[0-9]+)?$ ]]; then
        m=${BASH_REMATCH[1]}; s=${BASH_REMATCH[2]}
        echo $(( m*60 + s ))
    else
        echo "${t%%.*}"
    fi
}

# ── Format seconds → HH:MM:SS ─────────────────────────────────────────────────
fmt_duration() {
    local total=$1
    printf "%02d:%02d:%02d" $(( total/3600 )) $(( (total%3600)/60 )) $(( total%60 ))
}

# ── Sanitize a string for use in a filename ───────────────────────────────────
sanitize_name() {
    local s="$1"
    # Replace special chars with underscores
    s="${s//[\/\\:*?\"<>|]/_}"
    # Collapse runs of spaces, strip leading/trailing, then replace spaces with _
    s=$(echo "$s" | tr -s ' ')
    s="${s## }"; s="${s%% }"
    s="${s// /_}"
    # Collapse runs of underscores
    s=$(echo "$s" | tr -s '_')
    s="${s#_}"; s="${s%_}"
    echo "${s:0:200}"
}

# ── Show video info (pure ffprobe, no python needed) ─────────────────────────
show_info() {
    local file="$1"
    [[ -f "$file" ]] || { log_err "File not found: $file"; exit 1; }

    log_info "Video info: ${CYN}${file}${RST}"
    echo

    # duration & size from format
    local dur size
    dur=$(ffprobe -v error -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null || echo 0)
    size=$(ffprobe -v error -show_entries format=size \
        -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null || echo 0)

    local dur_int=${dur%%.*}
    local size_mb
    size_mb=$(awk "BEGIN{printf \"%.1f\", $size/1048576}")

    printf "  %-12s %s  (%.2fs)\n" "Duration :" "$(fmt_duration "$dur_int")" "$dur"
    printf "  %-12s %s MB\n"       "Size :"     "$size_mb"

    # per-stream info
    while IFS='|' read -r ctype cname width height fps_raw samplerate channels; do
        case "$ctype" in
            video)
                local fps
                fps=$(awk -v r="$fps_raw" 'BEGIN{
                    n=split(r,a,"/");
                    if(n==2 && a[2]+0>0) printf "%.2f", a[1]/a[2]; else print "?";
                }')
                printf "  %-12s %s  %sx%s  %s fps\n" "Video :" "$cname" "$width" "$height" "$fps"
                ;;
            audio)
                printf "  %-12s %s  %s Hz  %sch\n" "Audio :" "$cname" "$samplerate" "$channels"
                ;;
        esac
    done < <(ffprobe -v error \
        -show_entries "stream=codec_type,codec_name,width,height,r_frame_rate,sample_rate,channels" \
        -of csv=p=0:s='|' "$file" 2>/dev/null)

    # chapters info
    echo
    local chapter_count
    chapter_count=$(ffprobe -v error -show_chapters -of flat "$file" 2>/dev/null \
        | grep -c 'chapters\.chapter\.[0-9].*\.start_time=' || true)
    if [[ "$chapter_count" -gt 0 ]]; then
        printf "  %-12s %s chapter(s)\n" "Chapters :" "$chapter_count"
        local idx=0 ch_start=0 ch_end=0
        while IFS= read -r line; do
            local key val
            key="${line%%=*}"
            val="${line#*=}"
            val="${val%\"}"   # strip trailing quote
            val="${val#\"}"   # strip leading quote
            case "$key" in
                start_time) ch_start="${val%%.*}" ;;
                end_time)   ch_end="${val%%.*}" ;;
                tags.title)
                    idx=$(( idx + 1 ))
                    printf "    %02d. %-30s %s → %s  (%s)\n" \
                        "$idx" "$val" "$(fmt_duration "$ch_start")" "$(fmt_duration "$ch_end")" \
                        "$(fmt_duration $(( ch_end - ch_start )))"
                    ;;
            esac
        done < <(ffprobe -v error -show_chapters -of flat "$file" 2>/dev/null \
            | grep -E 'chapters\.chapter\.[0-9]+\.(start_time|end_time|tags\.title)=' \
            | sed 's/chapters\.chapter\.[0-9]*\.//')
    else
        printf "  %-12s none\n" "Chapters :"
    fi
}

# ── Run ffmpeg cut for a single clip ─────────────────────────────────────────
run_cut() {
    local input="$1" start_fmt="$2" end_fmt="$3" clip_sec="$4" output="$5"
    local fast="${6:-0}" overwrite="${7:-0}"

    local ffmpeg_ow=()
    [[ "$overwrite" -eq 1 ]] && ffmpeg_ow=(-y)

    if [[ "$fast" -eq 1 ]]; then
        ffmpeg -loglevel warning -stats \
            "${ffmpeg_ow[@]}" \
            -ss "$start_fmt" \
            -to "$end_fmt" \
            -i "$input" \
            -c copy \
            -avoid_negative_ts make_zero \
            -map_metadata 0 \
            "$output"
    else
        ffmpeg -loglevel warning -stats \
            "${ffmpeg_ow[@]}" \
            -i "$input" \
            -ss "$start_fmt" \
            -t  "$clip_sec" \
            -c:v libx264 -crf 18 -preset fast \
            -c:a aac -b:a 192k \
            -movflags +faststart \
            -map_metadata 0 \
            "$output"
    fi
}

# ── Chapter split mode ────────────────────────────────────────────────────────
do_chapters() {
    local input="$1" out_dir="$2" fast="$3" overwrite="$4"
    local ext="${input##*.}"

    # Create output directory if needed
    if [[ -n "$out_dir" ]]; then
        mkdir -p "$out_dir" || { log_err "Cannot create directory: $out_dir"; exit 1; }
    else
        out_dir="."
    fi

    # Read chapters using ffprobe JSON output
    local chapters_json
    chapters_json=$(ffprobe -v error -show_chapters -print_format json "$input" 2>/dev/null)

    if [[ -z "$chapters_json" ]]; then
        log_err "Could not read chapter data from: $input"
        exit 1
    fi

    # Parse chapters with awk (no python/jq dependency)
    local chapter_count
    chapter_count=$(echo "$chapters_json" | grep -c '"id"' || true)

    if [[ "$chapter_count" -eq 0 ]]; then
        log_err "No chapters found in: ${input}"
        log_err "Use --info to check if the file has embedded chapters."
        exit 1
    fi

    log_info "Found ${BLD}${chapter_count}${RST} chapter(s) in: ${CYN}${input}${RST}"
    log_info "Output directory: ${CYN}${out_dir}${RST}"
    if [[ $fast -eq 1 ]]; then
        log_info "Mode     : ${YLW}stream copy${RST} (fast — cuts snap to nearest keyframe)"
    else
        log_info "Mode     : re-encode (frame-accurate, libx264 crf 18)"
    fi
    echo

    # Extract chapter info line by line
    # ffprobe flat format: chapters.N.start_time, end_time, tags.title
    local num=0
    local ch_start ch_end ch_title ch_start_sec ch_end_sec clip_sec

    # Build arrays from flat ffprobe output
    local -a starts=() ends=() titles=()
    while IFS= read -r line; do
        key="${line%%=*}"
        val="${line#*=}"
        val="${val%\"}"   # strip trailing quote
        val="${val#\"}"   # strip leading quote
        case "$key" in
            start_time)  starts+=( "${val%%.*}" ) ;;
            end_time)    ends+=( "${val%%.*}" ) ;;
            tags.title)  titles+=( "$val" ) ;;
        esac
    done < <(ffprobe -v error -show_chapters -of flat "$input" 2>/dev/null \
        | grep -E 'chapters\.chapter\.[0-9]+\.(start_time|end_time|tags\.title)=' \
        | sed 's/chapters\.chapter\.[0-9]*\.//')

    local total=${#starts[@]}
    if [[ "$total" -eq 0 ]]; then
        log_err "No chapters found in: ${input}"
        exit 1
    fi

    local ok=0 fail=0
    for (( i=0; i<total; i++ )); do
        num=$(( i + 1 ))
        ch_start="${starts[$i]}"
        ch_end="${ends[$i]}"

        # Use chapter title if available, else "chapter_N"
        if [[ "${#titles[@]}" -gt "$i" && -n "${titles[$i]}" ]]; then
            ch_title=$(sanitize_name "${titles[$i]}")
        else
            ch_title="chapter_${num}"
        fi

        ch_start_sec="${ch_start%%.*}"
        ch_end_sec="${ch_end%%.*}"
        clip_sec=$(( ch_end_sec - ch_start_sec ))

        local out_file
        printf -v padded "%02d" "$num"
        out_file="${out_dir}/${padded}_${ch_title}.${ext}"

        log_info "Chapter ${BLD}${padded}/${total}${RST}: ${BLD}${ch_title}${RST}"
        log_info "  Range  : $(fmt_duration "$ch_start_sec") → $(fmt_duration "$ch_end_sec")  ($(fmt_duration "$clip_sec"))"
        log_info "  Output : ${CYN}${out_file}${RST}"

        if [[ -f "$out_file" && "$overwrite" -eq 0 ]]; then
            log_warn "  Skipping — file exists (use -y to overwrite): ${out_file}"
            echo
            (( fail++ )) || true
            continue
        fi

        if run_cut "$input" "$ch_start" "$ch_end" "$clip_sec" "$out_file" "$fast" "$overwrite"; then
            if [[ -f "$out_file" ]]; then
                local sz
                sz=$(du -sh "$out_file" 2>/dev/null | cut -f1)
                log_ok "  Saved  → ${CYN}${BLD}${out_file}${RST}  (${sz})"
                (( ok++ )) || true
            else
                log_err "  ffmpeg exited but output not found: ${out_file}"
                (( fail++ )) || true
            fi
        else
            log_err "  ffmpeg failed for chapter ${num}"
            (( fail++ )) || true
        fi
        echo
    done

    echo "──────────────────────────────────────────────"
    log_ok "Done — ${BLD}${ok}${RST} chapter(s) saved, ${BLD}${fail}${RST} skipped/failed."
}

# ── Defaults ──────────────────────────────────────────────────────────────────
INPUT=""
START=""
END=""
OUTPUT=""
FAST=0
OVERWRITE=0
CHAPTERS=0

# ── Arg parsing ───────────────────────────────────────────────────────────────
[[ $# -eq 0 ]] && { usage; exit 0; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)        usage; exit 0 ;;
        -v|--version)     echo "vid-cut $VERSION"; exit 0 ;;
        --info)
            [[ $# -lt 2 ]] && { log_err "--info requires a video path"; exit 1; }
            show_info "$2"; exit 0 ;;
        -s|--start)
            [[ $# -lt 2 ]] && { log_err "--start requires a value"; exit 1; }
            START="$2"; shift ;;
        -e|--end)
            [[ $# -lt 2 ]] && { log_err "--end requires a value"; exit 1; }
            END="$2"; shift ;;
        -o|--output)
            [[ $# -lt 2 ]] && { log_err "--output requires a value"; exit 1; }
            OUTPUT="$2"; shift ;;
        --chapters)       CHAPTERS=1 ;;
        --fast)           FAST=1 ;;
        -y|--overwrite)   OVERWRITE=1 ;;
        -*)
            log_err "Unknown option: $1"; echo; usage; exit 1 ;;
        *)
            if [[ -z "$INPUT" ]]; then INPUT="$1"
            else log_err "Unexpected argument: $1"; echo; usage; exit 1; fi ;;
    esac
    shift
done

# ── Validate input file ───────────────────────────────────────────────────────
[[ -z "$INPUT" ]] && { log_err "No video file specified."; echo; usage; exit 1; }

# strip surrounding quotes (drag-and-drop)
INPUT="${INPUT#\'}"; INPUT="${INPUT%\'}"
INPUT="${INPUT#\"}"; INPUT="${INPUT%\"}"

[[ ! -f "$INPUT" ]] && { log_err "File not found: $INPUT"; exit 1; }

# ── Chapter split mode ────────────────────────────────────────────────────────
if [[ $CHAPTERS -eq 1 ]]; then
    [[ -n "$START" || -n "$END" ]] && \
        log_warn "--start / --end are ignored in --chapters mode."
    do_chapters "$INPUT" "$OUTPUT" "$FAST" "$OVERWRITE"
    exit 0
fi

# ── Single clip mode ──────────────────────────────────────────────────────────
[[ -z "$START" ]] && { log_err "-s / --start is required."; exit 1; }
[[ -z "$END" ]]   && { log_err "-e / --end is required.";   exit 1; }

# ── Parse & validate times ────────────────────────────────────────────────────
START_FMT=$(parse_time "$START")
END_FMT=$(parse_time "$END")

START_SEC=$(to_seconds "$START_FMT")
END_SEC=$(to_seconds "$END_FMT")

if (( START_SEC >= END_SEC )); then
    log_err "Start (${START}) must be earlier than end (${END})."
    exit 1
fi

CLIP_SEC=$(( END_SEC - START_SEC ))

# ── Check against video duration ──────────────────────────────────────────────
VIDEO_DUR_RAW=$(ffprobe -v error -show_entries format=duration \
    -of default=noprint_wrappers=1:nokey=1 "$INPUT" 2>/dev/null || echo "0")
VIDEO_DUR_SEC=${VIDEO_DUR_RAW%%.*}

if (( START_SEC >= VIDEO_DUR_SEC )); then
    log_err "Start time (${START}) is past the end of the video ($(fmt_duration "$VIDEO_DUR_SEC"))."
    exit 1
fi

if (( END_SEC > VIDEO_DUR_SEC + 1 )); then
    log_warn "End time (${END}) exceeds video duration ($(fmt_duration "$VIDEO_DUR_SEC")) — clamping."
    END_FMT="$VIDEO_DUR_SEC"
    END_SEC="$VIDEO_DUR_SEC"
    CLIP_SEC=$(( END_SEC - START_SEC ))
fi

# ── Build output filename ─────────────────────────────────────────────────────
if [[ -z "$OUTPUT" ]]; then
    EXT="${INPUT##*.}"
    BASE="${INPUT%.*}"
    S_SAFE="${START//:/.}"
    E_SAFE="${END//:/.}"
    OUTPUT="${PWD}/$(basename "${BASE}")_cut_${S_SAFE}-${E_SAFE}.${EXT}"
fi

# ── Check output collision ────────────────────────────────────────────────────
if [[ -f "$OUTPUT" && $OVERWRITE -eq 0 ]]; then
    log_err "Output file already exists: ${OUTPUT}"
    log_err "Use -y / --overwrite to replace it."
    exit 1
fi

# ── Show plan ─────────────────────────────────────────────────────────────────
echo
log_info "Input    : ${CYN}${INPUT}${RST}"
log_info "Range    : ${BLD}${START}${RST} → ${BLD}${END}${RST}  (clip length: $(fmt_duration "$CLIP_SEC"))"
log_info "Output   : ${CYN}${OUTPUT}${RST}"
if [[ $FAST -eq 1 ]]; then
    log_info "Mode     : ${YLW}stream copy${RST} (fast — cuts snap to nearest keyframe)"
else
    log_info "Mode     : re-encode (frame-accurate, libx264 crf 18)"
fi
echo

# ── Run ffmpeg ────────────────────────────────────────────────────────────────
run_cut "$INPUT" "$START_FMT" "$END_FMT" "$CLIP_SEC" "$OUTPUT" "$FAST" "$OVERWRITE"

# ── Report ────────────────────────────────────────────────────────────────────
if [[ -f "$OUTPUT" ]]; then
    OUT_SIZE=$(du -sh "$OUTPUT" 2>/dev/null | cut -f1)
    echo
    log_ok "Saved → ${CYN}${BLD}${OUTPUT}${RST}  (${OUT_SIZE})"
else
    echo
    log_err "ffmpeg exited but output file not found — something went wrong."
    exit 1
fi
